#!/bin/bash
set -e
GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; NC='\033[0m'

echo -e "${GREEN}=== НАСТРОЙКА РУТИНГОВ (XRAY TEMPLATE) ===${NC}"

if [ ! -f /etc/x-ui/x-ui.db ]; then
    echo -e "${RED}Ошибка: База данных /etc/x-ui/x-ui.db не найдена! Установлена ли панель?${NC}"
    exit 1
fi

echo -e "${YELLOW}Обновляем шаблон Xray в базе данных...${NC}"

python3 << 'PYEOF'
import sqlite3, json, sys

db_path = '/etc/x-ui/x-ui.db'
conn = sqlite3.connect(db_path)
c = conn.cursor()

# Получаем текущий шаблон
c.execute("SELECT value FROM settings WHERE key='xrayTemplateConfig'")
row = c.fetchone()

if not row:
    print("Ошибка: Ключ xrayTemplateConfig не найден в базе.")
    sys.exit(1)

try:
    current_config = json.loads(row[0])
except json.JSONDecodeError:
    print("Ошибка: В базе лежит битый JSON. Используем дефолтный.")
    current_config = {}

# Базовый шаблон (если в базе пусто, соберем с нуля)
if not current_config:
    current_config = {
        "log": {"loglevel": "warning"},
        "api": {"services": ["HandlerService", "LoggerService", "StatsService", "RoutingService"], "tag": "api"},
        "stats": {},
        "policy": {
            "levels": {"0": {"statsUserUplink": True, "statsUserDownlink": True, "statsUserOnline": True}},
            "system": {"statsInboundUplink": True, "statsInboundDownlink": True, "statsOutboundUplink": True, "statsOutboundDownlink": True}
        },
        "inbounds": [{"listen": "127.0.0.1", "port": 62789, "protocol": "dokodemo-door", "settings": {"address": "127.0.0.1"}, "tag": "api", "sniffing": {"enabled": False}}],
        "outbounds": [{"protocol": "freedom", "tag": "direct"}, {"protocol": "blackhole", "tag": "blocked"}]
    }

# Прописываем идеальные рутинги
current_config["routing"] = {
    "domainStrategy": "IPIfNonMatch", # Сначала проверяем домены, потом IP
    "rules": [
        # 1. Служебный API
        {"type": "field", "inboundTag": ["api"], "outboundTag": "api"},
        
        # 2. Блокируем торренты (защита от абуза хостинга)
        {"type": "field", "protocol": ["bittorrent"], "outboundTag": "blocked"},
        
        # 3. Блокируем рекламу и трекеры
        {"type": "field", "domain": ["geosite:category-ads-all"], "outboundTag": "blocked"},
        
        # 4. Блокируем локальные сети (чтобы не текло)
        {"type": "field", "ip": ["geoip:private"], "outboundTag": "blocked"},
        {"type": "field", "domain": ["geosite:private"], "outboundTag": "blocked"}
    ]
}

# Сохраняем обратно в БД
new_json = json.dumps(current_config)
c.execute("UPDATE settings SET value=? WHERE key='xrayTemplateConfig'", (new_json,))
conn.commit()
conn.close()
print("\033[0;32mРутинги успешно обновлены! \033[0m")
PYEOF

echo -e "${YELLOW}Перезапускаем панель и Xray...${NC}"
systemctl restart x-ui
sleep 3

echo -e "${GREEN}=== ГОТОВО ===${NC}"
echo -e "Статус Xray:"
x-ui status | grep -E "Panel state|Xray state"
